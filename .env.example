# Copie ce fichier en ".env" et remplis chaque valeur.
# Ne publie jamais le fichier .env rempli ; utilise le coffre de secrets de l’hébergeur.

# Token d'accès de la Page Facebook.
PAGE_ACCESS_TOKEN=colle_ici_ton_token_de_page

# Secret choisi par toi pour la vérification initiale du webhook Meta.
VERIFY_TOKEN=choisis_un_secret_long_aleatoire_ici

# Secret d’application Meta (Meta for Developers > App settings > Basic).
# Il sert à vérifier X-Hub-Signature-256 sur chaque événement reçu.
META_APP_SECRET=colle_ici_le_secret_d_application_meta

# Clé API OpenAI, idéalement limitée au projet et rotatable.
OPENAI_API_KEY=colle_ici_ta_cle_openai

# Optionnel : personnalise le comportement de l’assistant.
SYSTEM_PROMPT=Tu es l'assistant vocal officiel de Carokaz Mada...

# Port fourni par l’hébergeur en production.
PORT=3000
