# Carokaz Mada — variables d'environnement (exemple uniquement)
# Ne jamais committer un vrai secret.
OPENAI_API_KEY=
PAGE_ACCESS_TOKEN=
VERIFY_TOKEN=
# Recommandé en production : secret de l'application Meta pour valider x-hub-signature-256.
META_APP_SECRET=
# Secours local uniquement ; laisser false en production.
ALLOW_UNSIGNED_WEBHOOKS=false
GRAPH_API_VERSION=v21.0
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
SYSTEM_PROMPT=
PORT=3000
WEBHOOK_BODY_LIMIT=256kb
MAX_EVENTS_PER_REQUEST=25
MAX_USER_TEXT_CHARS=4000
MAX_AUDIO_BYTES=12582912
FETCH_TIMEOUT_MS=15000
DEDUPE_TTL_MS=600000
MAX_CONVERSATIONS=5000
