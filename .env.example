# Copie ce fichier en ".env" et remplis chaque valeur (ne jamais publier ce fichier rempli)

# Token d'accès de ta Page Facebook (généré dans Meta for Developers > ton App > Messenger > Configuration des Pages)
PAGE_ACCESS_TOKEN=REMPLACE_PAR_UN_SECRET_META

# App Secret Meta utilisé uniquement côté serveur pour valider X-Hub-Signature-256.
META_APP_SECRET=REMPLACE_PAR_UN_SECRET_META

# Mot secret que TU choisis toi-même (n'importe quel texte). Sert juste à vérifier le webhook avec Meta.
VERIFY_TOKEN=REMPLACE_PAR_UN_SECRET_LONG_ET_ALEATOIRE

# Version Graph API utilisée par le bot.
GRAPH_API_VERSION=v21.0

# Ta clé API OpenAI (platform.openai.com -> API Keys)
OPENAI_API_KEY=REMPLACE_PAR_UNE_CLE_OPENAI

# (Optionnel) Personnalise le comportement de l'assistant. Si vide, un message par défaut est utilisé.
SYSTEM_PROMPT=Tu es l'assistant vocal officiel de Carokaz Mada...

# Port du serveur (Render le fixe automatiquement, pas besoin de le changer)
PORT=3000
